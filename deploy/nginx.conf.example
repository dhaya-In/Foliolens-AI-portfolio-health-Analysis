# Example production reverse proxy: TLS termination + SPA + API on ONE origin.
# Same-origin hosting keeps the SameSite auth cookies working and avoids CORS entirely.
#
# Certificates: e.g. Let's Encrypt via certbot:
#   sudo certbot certonly --nginx -d foliolens.example.com
# Run the API with:  uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
# and set APP_ENV=production, FORCE_HTTPS=true, COOKIE_SECURE=true, TRUSTED_HOSTS=foliolens.example.com,
# CORS_ORIGINS=https://foliolens.example.com in backend/.env.

server {
    listen 80;
    server_name foliolens.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name foliolens.example.com;

    ssl_certificate     /etc/letsencrypt/live/foliolens.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/foliolens.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    client_max_body_size 2m;   # slightly above CSV_MAX_BYTES

    # Built SPA (frontend: npm run build -> dist/)
    root /var/www/foliolens/dist;
    location / {
        try_files $uri /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
