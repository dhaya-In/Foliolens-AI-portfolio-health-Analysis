# FolioLens backend configuration. Copy to backend/.env and fill in values.
# NEVER commit backend/.env - it is ignored by .gitignore.

# ---- Application ---------------------------------------------------------
APP_ENV=development                  # development | production | test
LOG_LEVEL=INFO
# Comma-separated list of browser origins allowed to call the API (exact match).
CORS_ORIGINS=http://localhost:5173
# Comma-separated hostnames accepted in the Host header ("*" = any; set real hosts in production).
TRUSTED_HOSTS=*
# Redirect/deny plain HTTP and send HSTS. Must be true in production (behind your TLS proxy).
FORCE_HTTPS=false

# ---- Database ------------------------------------------------------------
# SQLite (default, file in backend/) or PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg://foliolens:CHANGE_ME@db-host:5432/foliolens
DATABASE_URL=sqlite:///./foliolens.db

# ---- Authentication (JWT) ------------------------------------------------
# REQUIRED. At least 32 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ISSUER=foliolens-api
JWT_AUDIENCE=foliolens-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Cookies: COOKIE_SECURE must be true in production (HTTPS only).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax                  # lax | strict | none (none requires COOKIE_SECURE=true)
COOKIE_DOMAIN=

# Rate limits, "count/seconds" (in-process; use a shared store if you run several instances)
LOGIN_RATE_LIMIT=5/60
REGISTER_RATE_LIMIT=5/3600
REFRESH_RATE_LIMIT=30/60
API_RATE_LIMIT=120/60

# ---- CSV upload encryption -----------------------------------------------
# REQUIRED. Base64 of exactly 32 random bytes (AES-256-GCM key). Generate with:
#   python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# Rotating it makes any *pending* (unconfirmed) uploads unreadable; imported holdings are unaffected.
CSV_ENCRYPTION_KEY=
CSV_MAX_BYTES=1048576
CSV_MAX_ROWS=5000
CSV_UPLOAD_TTL_MINUTES=30

# ---- Market data ---------------------------------------------------------
# yahoo   = Yahoo Finance via yfinance (no key; NSE/BSE/US/global; unofficial API)
# finnhub = Finnhub quotes + profiles (needs MARKET_DATA_API_KEY; free tier mainly US). History/search use Yahoo.
MARKET_DATA_PROVIDER=yahoo
MARKET_DATA_API_KEY=
# Listing preference for bare tickers: NSE, then BSE, then the bare (US) symbol.
TICKER_SUFFIXES=.NS,.BO,
QUOTE_CACHE_SECONDS=120
PROFILE_CACHE_SECONDS=86400
HISTORY_CACHE_SECONDS=3600
STALE_AFTER_SECONDS=900
PROVIDER_TIMEOUT_SECONDS=12

# ---- Financial news ------------------------------------------------------
# yahoo     = Yahoo Finance news search (no key; headlines without summaries)
# marketaux = https://www.marketaux.com (needs FINANCIAL_NEWS_API_KEY; summaries + entity sentiment)
FINANCIAL_NEWS_PROVIDER=yahoo
FINANCIAL_NEWS_API_KEY=
NEWS_CACHE_SECONDS=900

# ---- AI insights (Anthropic Claude) ---------------------------------------
# Optional. Without a key, rule-based insights are shown and clearly labelled.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=60
